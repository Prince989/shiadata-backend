# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=shiadata-backend
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
TRUST_PROXY=false
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
LOG_LEVEL=debug
LOG_PRETTY=true
REQUEST_TIMEOUT_MS=120000
EXPOSE_ERROR_DETAILS=true
OPS_TOKEN=change-me

# -----------------------------------------------------------------------------
# MongoDB (dedicated container, docker-compose.yml, port 27018)
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27018/shiadata?directConnection=true
MONGO_DB_NAME=shiadata
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_AUTO_INDEX=true

# -----------------------------------------------------------------------------
# Redis (dedicated container, docker-compose.yml, port 6380)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=shiadata:

# -----------------------------------------------------------------------------
# JWT / Auth (used starting milestone 6)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
JWT_ISSUER=shiadata
JWT_AUDIENCE=shiadata-api

# -----------------------------------------------------------------------------
# LLM keys -- mirrors AIEngine/.env's GOOGLE_API_KEY* convention
# -----------------------------------------------------------------------------
LLM_REQUEST_TIMEOUT_MS=60000
LLM_DEADLINE_MS=90000
GOOGLE_API_KEY=
GOOGLE_API_KEY1=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Python engine
# -----------------------------------------------------------------------------
PYTHON_ENGINE_BASE_URL=http://127.0.0.1:8000
# Must be identical to shiadata-rag INTERNAL_API_KEY or every /search call 401/503s
# and lifestyle counseling falls back to an empty RAG (degraded).
PYTHON_ENGINE_INTERNAL_API_KEY=
PYTHON_ENGINE_HOST=127.0.0.1
PYTHON_ENGINE_PORT=8000

# -----------------------------------------------------------------------------
# Throttling
# -----------------------------------------------------------------------------
THROTTLE_STORAGE=redis
